{
  "id": "aed-pl",
  "version": "2.0.0",
  "title": "Standard danych o defibrylatorach AED dla krajowej listy",
  "description": "Jeden wiersz opisuje jeden defibrylator. Wymagane są tylko identyfikator, położenie i nazwa miejsca; pozostałe pola są zalecane lub opcjonalne.",
  "file": {
    "encoding": "UTF-8",
    "delimiter": ",",
    "decimal": ".",
    "date_format": "RRRR-MM-DD",
    "boolean_values": { "true": ["tak", "t", "1", "true", "yes", "y"], "false": ["nie", "n", "0", "false", "no"] },
    "crs": "EPSG:4326 (WGS 84), stopnie dziesiętne"
  },
  "sections": [
    { "id": "id", "label": "Identyfikacja i położenie" },
    { "id": "adres", "label": "Adres i miejsce" },
    { "id": "dostepnosc", "label": "Dostępność" },
    { "id": "urzadzenie", "label": "Urządzenie" },
    { "id": "opiekun", "label": "Opiekun i powiązania" }
  ],
  "merge": {
    "identity": [["udi_di", "serial_number"], ["manufacturer", "model", "serial_number"]],
    "link": "same_as",
    "conflict_fields": ["opening_hours", "is_24_7", "access", "status", "indoor", "floor", "unlock_method"]
  },
  "fields": [
    { "name": "aed_id", "label": "Identyfikator AED", "section": "id", "level": "wymagane", "type": "text", "unique": true,
      "pattern": "^[A-Za-z0-9._:/-]{1,64}$", "example": "KRO-0001",
      "description": "Klucz rekordu: unikalny w pliku, nigdy nie używany ponownie dla innego urządzenia. Litery bez polskich znaków, cyfry oraz . _ : / -." },
    { "name": "lat", "label": "Szerokość geograficzna", "section": "id", "level": "wymagane", "type": "number", "min": 49.0, "max": 54.9, "example": "49.718809",
      "description": "WGS 84, stopnie dziesiętne." },
    { "name": "lon", "label": "Długość geograficzna", "section": "id", "level": "wymagane", "type": "number", "min": 14.1, "max": 24.2, "example": "21.720344",
      "description": "WGS 84, stopnie dziesiętne." },
    { "name": "name", "label": "Nazwa miejsca", "section": "id", "level": "wymagane", "type": "text", "minLength": 2, "maxLength": 200, "example": "Zespół Krytych Pływalni",
      "description": "Nazwa miejsca pokazywana na mapie, 2–200 znaków." },

    { "name": "address", "label": "Pełny adres", "section": "adres", "level": "zalecane", "type": "text", "maxLength": 300, "example": "ul. Jasna 1, 38-400 Krosno",
      "description": "Cały adres w jednym polu." },
    { "name": "street", "label": "Ulica", "section": "adres", "level": "zalecane", "type": "text", "maxLength": 150, "example": "ul. Jasna",
      "description": "Z przedrostkiem (ul., al., pl.). Ulica i numer budynku liczą się razem jako jedno pole zalecane." },
    { "name": "house_number", "label": "Numer budynku", "section": "adres", "level": "zalecane", "type": "text", "maxLength": 20, "example": "5A",
      "description": "Może zawierać literę." },
    { "name": "postcode", "label": "Kod pocztowy", "section": "adres", "level": "zalecane", "type": "text", "pattern": "^[0-9]{2}-[0-9]{3}$", "example": "38-400" },
    { "name": "city", "label": "Miejscowość", "section": "adres", "level": "zalecane", "type": "text", "maxLength": 100, "example": "Krosno" },
    { "name": "teryt", "label": "Kod TERYT (TERC)", "section": "adres", "level": "opcjonalne", "type": "text", "pattern": "^[0-9]{7}$", "example": "1861011",
      "description": "7-cyfrowy kod jednostki podziału terytorialnego (TERC) z rejestru TERYT." },
    { "name": "placement", "label": "Dokładne miejsce", "section": "adres", "level": "zalecane", "type": "text", "maxLength": 1500, "softMaxLength": 255, "example": "Hol główny przy recepcji",
      "description": "Gdzie dokładnie wisi AED." },
    { "name": "floor", "label": "Piętro", "section": "adres", "level": "opcjonalne", "type": "text", "pattern": "^-?[0-9]{1,3}$", "example": "0",
      "description": "0 = parter, -1 = piwnica." },
    { "name": "indoor", "label": "Wewnątrz budynku", "section": "adres", "level": "zalecane", "type": "boolean", "example": "tak" },

    { "name": "access", "label": "Kto ma dostęp", "section": "dostepnosc", "level": "zalecane", "type": "enum", "example": "yes",
      "enum": [
        { "code": "yes", "label": "Każdy, bez pytania o zgodę" },
        { "code": "customers", "label": "Klienci, uczniowie, goście obiektu" },
        { "code": "permit", "label": "Za zgodą obsługi lub przepustką" },
        { "code": "private", "label": "Tylko personel" },
        { "code": "no", "label": "Niedostępny dla osób z zewnątrz" } ] },
    { "name": "opening_hours", "label": "Godziny dostępności", "section": "dostepnosc", "level": "zalecane", "type": "opening_hours", "example": "Mo-Fr 08:00-16:00",
      "description": "Składnia opening_hours z OpenStreetMap." },
    { "name": "is_24_7", "label": "Dostępny całą dobę (24/7)", "section": "dostepnosc", "level": "zalecane", "type": "boolean", "example": "nie" },
    { "name": "cabinet_locked", "label": "Szafka zamknięta", "section": "dostepnosc", "level": "opcjonalne", "type": "boolean", "example": "nie" },
    { "name": "unlock_method", "label": "Jak otworzyć szafkę", "section": "dostepnosc", "level": "opcjonalne", "type": "enum", "example": "none",
      "enum": [
        { "code": "none", "label": "Szafka otwarta, bez zabezpieczeń" },
        { "code": "code_112", "label": "Kod podaje dyspozytor 112" },
        { "code": "key", "label": "Na klucz" },
        { "code": "staff", "label": "Wydaje personel obiektu" } ] },

    { "name": "status", "label": "Stan urządzenia", "section": "urzadzenie", "level": "zalecane", "type": "enum", "example": "active",
      "enum": [
        { "code": "active", "label": "Sprawny i na miejscu" },
        { "code": "out_of_service", "label": "Czasowo niesprawny lub w serwisie" },
        { "code": "removed", "label": "Zdjęty lub zlikwidowany" },
        { "code": "unknown", "label": "Stan nieznany" } ] },
    { "name": "pads_expiry", "label": "Ważność elektrod", "section": "urzadzenie", "level": "zalecane", "type": "date", "expiry": true, "example": "2027-03-31" },
    { "name": "battery_expiry", "label": "Ważność baterii", "section": "urzadzenie", "level": "zalecane", "type": "date", "expiry": true, "example": "2028-01-31" },
    { "name": "last_verified", "label": "Data sprawdzenia na miejscu", "section": "urzadzenie", "level": "zalecane", "type": "date", "notFuture": true, "verified": true, "example": "2026-10-15",
      "description": "Data ostatniego sprawdzenia na miejscu, że AED jest tam, gdzie wskazuje rekord." },
    { "name": "manufacturer", "label": "Producent", "section": "urzadzenie", "level": "opcjonalne", "type": "text", "maxLength": 100, "example": "Philips" },
    { "name": "model", "label": "Model", "section": "urzadzenie", "level": "opcjonalne", "type": "text", "maxLength": 100, "example": "HeartStart FRx" },
    { "name": "serial_number", "label": "Numer seryjny", "section": "urzadzenie", "level": "opcjonalne", "type": "text", "maxLength": 64, "example": "B21G-01234",
      "description": "Z tabliczki urządzenia albo identyfikator UDI (21)." },
    { "name": "udi_di", "label": "Kod UDI-DI", "section": "urzadzenie", "level": "opcjonalne", "type": "text", "pattern": "^[0-9]{14}$", "example": "00884838034567",
      "description": "14 cyfr, identyfikator UDI (01) z etykiety urządzenia." },
    { "name": "paediatric_capable", "label": "Elektrody lub tryb dla dzieci", "section": "urzadzenie", "level": "opcjonalne", "type": "boolean", "example": "tak" },

    { "name": "operator", "label": "Opiekun urządzenia", "section": "opiekun", "level": "opcjonalne", "type": "text", "maxLength": 200, "example": "Zespół Krytych Pływalni w Krośnie",
      "description": "Kto opiekuje się urządzeniem na miejscu." },
    { "name": "contact_phone", "label": "Telefon kontaktowy", "section": "opiekun", "level": "opcjonalne", "type": "phone", "example": "+48 13 000 00 00",
      "description": "Numer instytucji, nie osoby prywatnej." },
    { "name": "notes", "label": "Uwagi", "section": "opiekun", "level": "opcjonalne", "type": "text", "maxLength": 1000, "example": "" },
    { "name": "same_as", "label": "To samo urządzenie w innych rejestrach", "section": "opiekun", "level": "opcjonalne", "type": "same_as", "example": "000526989:5;osm:node/4419237512",
      "description": "REGON:aed_id albo osm:node/N, kilka rozdzielonych średnikiem." }
  ]
}
