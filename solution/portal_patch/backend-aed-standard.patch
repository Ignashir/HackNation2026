+"""
+National list of a data standard (e.g. "Krajowy wykaz AED"), built the way the portal builds the DGA list
+(`resources/tasks/dga.py`), plus merging by the standard's published rules (`x-standard.merge`).
+
+1. Every conforming, published file of every dataset bound to the standard is converted to the standard's columns.
+2. Rows are grouped into one device only on deterministic evidence: an explicit `same_as` reference (another
+   provider's `REGON:aed_id`, or a shared `osm:` reference) or the same device identity (UDI + serial, or
+   manufacturer + model + serial). Being close to each other only flags a possible duplicate.
+3. Each field of a merged device comes from the provider with the highest precedence (by institution type), then the
+   newer `last_verified`; empty values never overwrite filled ones. Disagreements in critical fields are reported.
+4. Four files with stable ids are published by the coordinating institution: the merged list, the full list of all
+   provider rows, the conflicts and the changes since the previous run.
+
+Deterministic only (no AI). Providers stay accountable for their rows: every merged device lists all its sources.
+"""
+
+import csv
+import datetime
+import hashlib
+import logging
+import math
+import os
+import tempfile
+from collections import defaultdict
+
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.db import transaction
+from django.utils import timezone
+
+from mcod.standards.conformity import normalize_rows, request_verification
+from mcod.standards.models import DataStandard, ResourceConformity, StandardAggregate
+
+logger = logging.getLogger("mcod")
+
+PROVENANCE_COLUMNS = ["provider_aed_id", "provider", "provider_id", "source_dataset_id", "source_resource_id", "record_key"]
+MERGED_COLUMNS = PROVENANCE_COLUMNS + ["sources", "merged_from", "possible_duplicate_of"]
+FULL_COLUMNS = PROVENANCE_COLUMNS + ["merged_into"]
+CHANGE_COLUMNS = ["change", "aed_id", "record_key", "provider", "name", "lat", "lon"]
+CONFLICT_COLUMNS = ["aed_id", "lat", "lon", "name", "record_key", "field", "source_record_key", "provider", "value"]
+
+DEFAULT_RULES = {
+    "precedence_by_institution_type": {"local": 30, "state": 30, "private": 20, "developer": 20, "other": 10},
+    "default_precedence": 10,
+    "flag_distance_m": 50,
+    "conflict_fields": ["opening_hours", "is_24_7", "access", "status"],
+    "conflict_distance_m": 25,
+}
+
+
+class AggregateError(Exception):
+    pass
+
+
+def merge_rules(standard):
+    rules = dict(DEFAULT_RULES)
+    rules.update(standard.definition.get("x-standard", {}).get("merge", {}))
+    return rules
+
+
+def _texts(standard):
+    meta = standard.definition.get("x-standard", {})
+    title = meta.get("aggregate_title_pl") or f"{standard.title} – wykaz krajowy"
+    return {
+        "dataset_title": title,
+        "dataset_notes": (
+            f"Wykaz zbiorczy wszystkich zgodnych ze standardem {standard} plików opublikowanych w portalu przez "
+            "dostawców. Rekordy opisujące to samo urządzenie są łączone tylko na podstawie jawnych powiązań "
+            "(kolumna same_as) lub tego samego identyfikatora urządzenia; wartości pochodzą od dostawcy o najwyższym "
+            "priorytecie (zasady w definicji standardu). Każdy wiersz wskazuje dostawcę i wszystkie źródła (sources), "
+            "a rozbieżności między dostawcami są publikowane w osobnym pliku. Wykaz jest odtwarzany automatycznie."
+        ),
+        "list_title": title,
+        "list_description": (
+            f"Jedno urządzenie = jeden wiersz, w standardzie {standard}. aed_id to krajowy klucz rekordu "
+            "(identyfikator dostawcy:aed_id dostawcy), sources – wszystkie połączone rekordy dostawców, "
+            "possible_duplicate_of – rekord innego dostawcy w pobliżu (do sprawdzenia, nie połączony)."
+        ),
+        "full_title": f"{title} – wszystkie rekordy dostawców",
+        "full_description": "Wszystkie wiersze wszystkich dostawców bez łączenia; merged_into wskazuje urządzenie w wykazie.",
+        "conflicts_title": f"{title} – rozbieżności między dostawcami",
+        "conflicts_description": "Pola, w których połączone rekordy różnych dostawców podają różne wartości.",
+        "changes_title": f"{title} – zmiany od poprzedniej wersji",
+        "changes_description": "Urządzenia dodane (added), usunięte (removed) lub zmienione (changed) od poprzedniego wykazu.",
+    }
+
+
+def conforming_files(standard, exclude_dataset_id=None):
+    """Published files that conform to the standard, in published datasets bound to it (excluding the list itself)."""
+    qs = (
+        ResourceConformity.objects.filter(
+            standard=standard,
+            status=ResourceConformity.STATUS_OK,
+            resource__status="published",
+            resource__is_removed=False,
+            resource__dataset__status="published",
+            resource__dataset__is_removed=False,
+            resource__dataset__data_standard=standard,
+        )
+        .select_related("resource", "resource__dataset", "resource__dataset__organization")
+        .order_by("resource__dataset__organization__title", "resource_id")
+    )
+    if exclude_dataset_id:
+        qs = qs.exclude(resource__dataset_id=exclude_dataset_id)
+    return qs
+
+
+# --- collecting -----------------------------------------------------------------
+
+
+def collect_rows(standard, aggregate, rules):
+    """All rows of all conforming files, in the standard's columns, with provenance. Returns (rows, providers, skipped)."""
+    precedence = rules["precedence_by_institution_type"]
+    rows, providers, skipped, seen = [], [], [], set()
+    for conformity in conforming_files(standard, exclude_dataset_id=aggregate.dataset_id):
+        resource = conformity.resource
+        org = resource.dataset.organization
+        count = 0
+        try:
+            for row in normalize_rows(resource, standard, conformity.mapping):
+                key = f"{org.pk}:{row.get('aed_id', '')}"
+                if key in seen:  # duplicate aed_id within one provider's file: keep the first
+                    continue
+                seen.add(key)
+                row.update(
+                    provider_aed_id=row.get("aed_id", ""),
+                    provider=org.title,
+                    provider_id=str(org.pk),
+                    source_dataset_id=str(resource.dataset_id),
+                    source_resource_id=str(resource.pk),
+                    record_key=key,
+                )
+                row["_regon"] = (org.regon or "").strip()
+                row["_precedence"] = precedence.get(org.institution_type, rules["default_precedence"])
+                rows.append(row)
+                count += 1
+        except Exception as exc:  # a broken source must not stop the national list (as in the DGA list)
+            logger.exception("standards: skipping resource %s in the %s list", resource.pk, standard.code)
+            skipped.append({"resource_id": resource.pk, "provider": org.title, "error": str(exc)[:300]})
+            continue
+        providers.append(
+            {
+                "provider": org.title,
+                "provider_id": org.pk,
+                "dataset_id": resource.dataset_id,
+                "resource_id": resource.pk,
+                "rows": count,
+                "precedence": precedence.get(org.institution_type, rules["default_precedence"]),
+            }
+        )
+    return rows, providers, skipped
+
+
+# --- grouping -------------------------------------------------------------------
+
+
+class _UnionFind:
+    def __init__(self, n):
+        self.parent = list(range(n))
+
+    def find(self, i):
+        while self.parent[i] != i:
+            self.parent[i] = self.parent[self.parent[i]]
+            i = self.parent[i]
+        return i
+
+    def union(self, a, b):
+        ra, rb = self.find(a), self.find(b)
+        if ra != rb:
+            self.parent[max(ra, rb)] = min(ra, rb)
+
+
+def _refs(value):
+    return [r.strip() for r in (value or "").split(";") if r.strip()]
+
+
+def group_rows(rows):
+    """Group rows that describe the same device. Returns (groups, unresolved_refs)."""
+    uf = _UnionFind(len(rows))
+    own = {}  # "REGON:aed_id" -> row index
+    for i, row in enumerate(rows):
+        if row["_regon"]:
+            own[f"{row['_regon']}:{row['provider_aed_id']}"] = i
+
+    shared = defaultdict(list)  # osm reference or device identity -> row indexes
+    unresolved = 0
+    for i, row in enumerate(rows):
+        for ref in _refs(row.get("same_as")):
+            if ref.startswith("osm:"):
+                shared[ref].append(i)
+            elif ref in own:
+                uf.union(i, own[ref])
+            else:
+                unresolved += 1
+        serial = (row.get("serial_number") or "").strip().lower()
+        if serial and (row.get("udi_di") or "").strip():
+            shared[("udi", row["udi_di"].strip(), serial)].append(i)
+        if serial and (row.get("manufacturer") or "").strip() and (row.get("model") or "").strip():
+            shared[("device", row["manufacturer"].strip().lower(), row["model"].strip().lower(), serial)].append(i)
+    for members in shared.values():
+        for j in members[1:]:
+            uf.union(members[0], j)
+
+    groups = defaultdict(list)
+    for i in range(len(rows)):
+        groups[uf.find(i)].append(i)
+    return list(groups.values()), unresolved
+
+
+# --- merging --------------------------------------------------------------------
+
+
+def _distance_m(a, b):
+    try:
+        la1, lo1, la2, lo2 = (math.radians(float(x)) for x in (a["lat"], a["lon"], b["lat"], b["lon"]))
+    except (TypeError, ValueError):
+        return None
+    h = math.sin((la2 - la1) / 2) ** 2 + math.cos(la1) * math.cos(la2) * math.sin((lo2 - lo1) / 2) ** 2
+    return 6371000 * 2 * math.asin(math.sqrt(h))
+
+
+def _norm(value):
+    return " ".join(str(value).split()).lower()
+
+
+def merge_group(rows, members, names, rules):
+    """One device from a group of provider rows. Returns (merged_row, conflicts)."""
+    order = sorted(members, key=lambda i: (rows[i]["_precedence"], rows[i].get("last_verified") or "", -i), reverse=True)
+    primary = rows[order[0]]
+    merged = {}
+    for name in names:
+        if name in ("aed_id", "same_as", "lat", "lon"):
+            continue
+        merged[name] = next((rows[i][name] for i in order if rows[i].get(name)), "")
+    merged["lat"], merged["lon"] = primary["lat"], primary["lon"]  # coordinates always come together
+    merged["aed_id"] = primary["record_key"]
+
+    refs = []
+    for i in order:
+        row = rows[i]
+        if i != order[0] and row["_regon"]:
+            refs.append(f"{row['_regon']}:{row['provider_aed_id']}")
+        refs.extend(_refs(row.get("same_as")))
+    own_ref = f"{primary['_regon']}:{primary['provider_aed_id']}" if primary["_regon"] else None
+    merged["same_as"] = ";".join(dict.fromkeys(r for r in refs if r != own_ref))
+
+    for key in PROVENANCE_COLUMNS:
+        merged[key] = primary[key]
+    merged["sources"] = ";".join(rows[i]["record_key"] for i in order)
+    merged["merged_from"] = str(len(order))
+    merged["possible_duplicate_of"] = ""
+
+    conflicts = []
+    if len(order) > 1:
+        for field in rules["conflict_fields"]:
+            values = [(i, rows[i].get(field)) for i in order if rows[i].get(field)]
+            if len({_norm(v) for _, v in values}) > 1:
+                conflicts.extend((field, rows[i], v) for i, v in values)
+        far = [i for i in order[1:] if (_distance_m(primary, rows[i]) or 0) > rules["conflict_distance_m"]]
+        if far:
+            conflicts.extend(("position", rows[i], f"{rows[i]['lat']},{rows[i]['lon']}") for i in [order[0], *far])
+    return merged, conflicts
+
+
+def flag_nearby(merged_rows, distance_m):
+    """Mark devices of different providers closer than distance_m: possible duplicates (reported, never merged)."""
+    cell_lat = distance_m / 111_000
+    cells = defaultdict(list)
+    for idx, row in enumerate(merged_rows):
+        try:
+            lat, lon = float(row["lat"]), float(row["lon"])
+        except (TypeError, ValueError):
+            continue
+        cell_lon = cell_lat / max(math.cos(math.radians(lat)), 0.1)
+        cells[(int(lat // cell_lat), int(lon // cell_lon))].append(idx)
+        row["_cell"] = (int(lat // cell_lat), int(lon // cell_lon))
+    flagged = 0
+    for idx, row in enumerate(merged_rows):
+        if "_cell" not in row:
+            continue
+        mine = set(row["sources"].split(";"))
+        my_providers = {k.split(":", 1)[0] for k in mine}
+        best = None
+        cy, cx = row["_cell"]
+        for dy in (-1, 0, 1):
+            for dx in (-1, 0, 1):
+                for other in cells.get((cy + dy, cx + dx), ()):
+                    if other == idx:
+                        continue
+                    o = merged_rows[other]
+                    if my_providers & {k.split(":", 1)[0] for k in o["sources"].split(";")}:
+                        continue  # same provider: several AEDs in one place are normal
+                    d = _distance_m(row, o)
+                    if d is not None and d <= distance_m and (best is None or d < best[0]):
+                        best = (d, o["aed_id"])
+        if best:
+            row["possible_duplicate_of"] = best[1]
+            flagged += 1
+    for row in merged_rows:
+        row.pop("_cell", None)
+    return flagged
+
+
+# --- publishing -----------------------------------------------------------------
+
+
+def _ensure_dataset(standard, aggregate, owner, texts):
+    from mcod.categories.models import Category
+    from mcod.datasets.models import Dataset
+    from mcod.tags.models import Tag
+
+    dataset = aggregate.dataset
+    if dataset is None or dataset.is_removed:
+        dataset = Dataset.objects.create(
+            title=texts["dataset_title"],
+            notes=texts["dataset_notes"],
+            organization=owner,
+            data_standard=standard,
+            update_frequency="daily",
+            has_dynamic_data=False,
+            has_high_value_data=False,
+            has_high_value_data_from_ec_list=False,
+            has_research_data=False,
+            status="published",
+        )
+        category = Category.objects.filter(code="HEAL").order_by("id").first()
+        if category:
+            dataset.categories.set([category])
+        tag, _ = Tag.objects.get_or_create(name=standard.code.upper(), language="pl", defaults={"status": "published"})
+        dataset.tags.add(tag)
+        aggregate.dataset = dataset
+    elif (dataset.title, dataset.notes) != (texts["dataset_title"], texts["dataset_notes"]):
+        Dataset.raw.filter(pk=dataset.pk).update(title=texts["dataset_title"], notes=texts["dataset_notes"])
+        dataset.refresh_from_db()
+    return dataset
+
+
+def _put_file(dataset, resource, path, title, description, file_name):
+    """Create the file the first time (verified, then published), or replace its content keeping the same id."""
+    from mcod.resources.models import Resource, ResourceFile
+
+    with open(path, "rb") as fh:
+        upload = SimpleUploadedFile(name=file_name, content=fh.read(), content_type="text/csv")
+    if resource is None or resource.is_removed:
+        resource = Resource.objects.create(
+            title=title,
+            description=description,
+            dataset=dataset,
+            status="draft",
+            data_date=datetime.date.today(),
+            has_dynamic_data=False,
+            has_high_value_data=False,
+            has_high_value_data_from_ec_list=False,
+            has_research_data=False,
+        )
+        ResourceFile.objects.create(resource=resource, is_main=True, file=upload)
+        request_verification(resource)  # published automatically once it conforms
+    else:
+        ResourceFile.objects.update_or_create(resource=resource, is_main=True, defaults={"file": upload})
+        Resource.raw.filter(pk=resource.pk).update(data_date=datetime.date.today(), title=title, description=description)
+        # Reload: the in-memory resource still points at the old file, which breaks the portal's file processing
+        # ("'LightStateFieldFile' object has no attribute 'instance'").
+        resource = Resource.raw.get(pk=resource.pk)
+        resource.revalidate()
+    return resource
+
+
+def _write_csv(prefix, header, rows):
+    fd, path = tempfile.mkstemp(suffix=".csv", prefix=prefix)
+    with os.fdopen(fd, "w", encoding="utf-8", newline="") as fh:
+        writer = csv.DictWriter(fh, fieldnames=header, lineterminator="\n", extrasaction="ignore")
+        writer.writeheader()
+        writer.writerows(rows)
+    return path
+
+
+def _publish(dataset, resource, rows, header, title, description, file_name, prefix):
+    path = _write_csv(prefix, header, rows)
+    try:
+        return _put_file(dataset, resource, path, title, description, file_name)
+    finally:
+        os.unlink(path)
+
+
+def _row_hash(row, columns):
+    return hashlib.sha1("\x1f".join(str(row.get(c, "")) for c in columns).encode("utf-8")).hexdigest()
+
+
+def build_aggregate(standard: DataStandard) -> StandardAggregate:
+    owner = standard.aggregate_owner
+    if owner is None:
+        raise AggregateError(f"{standard}: no national list owner (DataStandard.aggregate_owner)")
+
+    aggregate, _ = StandardAggregate.objects.get_or_create(standard=standard)
+    rules = merge_rules(standard)
+    texts = _texts(standard)
+    names = [f["name"] for f in standard.fields]
+    stem = f"{standard.code}-{standard.version}".replace(".", "_")
+    today = f"{timezone.localdate():%Y-%m-%d}"
+
+    with transaction.atomic():
+        dataset = _ensure_dataset(standard, aggregate, owner, texts)
+        aggregate.save()
+
+        rows, providers, skipped = collect_rows(standard, aggregate, rules)
+        groups, unresolved = group_rows(rows)
+        merged_rows, conflict_rows = [], []
+        for members in sorted(groups, key=min):
+            merged, conflicts = merge_group(rows, members, names, rules)
+            merged_rows.append(merged)
+            for i in members:
+                rows[i]["merged_into"] = merged["aed_id"]
+            for n, (field, source, value) in enumerate(conflicts, 1):
+                conflict_rows.append(
+                    {
+                        "aed_id": f"{merged['aed_id']}/{n}",  # must match the standard's aed_id pattern
+                        "lat": merged["lat"],
+                        "lon": merged["lon"],
+                        "name": merged["name"],
+                        "record_key": merged["aed_id"],
+                        "field": field,
+                        "source_record_key": source["record_key"],
+                        "provider": source["provider"],
+                        "value": value,
+                    }
+                )
+        flagged = flag_nearby(merged_rows, rules["flag_distance_m"])
+
+        # Changes against the previous merged list
+        previous = aggregate.snapshot or {}
+        snapshot, changes = {}, []
+        for row in merged_rows:
+            key, digest = row["aed_id"], _row_hash(row, names + ["sources"])
+            snapshot[key] = [digest, row.get("name", ""), row.get("lat", ""), row.get("lon", "")]
+            old = previous.get(key)
+            if old is None or old[0] != digest:
+                change = "added" if old is None else "changed"
+                changes.append({"change": change, "aed_id": key, "record_key": key, "provider": row["provider"],
+                                "name": row.get("name", ""), "lat": row.get("lat", ""), "lon": row.get("lon", "")})
+        provider_titles = {str(p["provider_id"]): p["provider"] for p in providers}
+        for key, old in previous.items():
+            if key not in snapshot:
+                changes.append({"change": "removed", "aed_id": key, "record_key": key,
+                                "provider": provider_titles.get(key.split(":", 1)[0], key.split(":", 1)[0]),
+                                "name": old[1], "lat": old[2], "lon": old[3]})
+
+        full_rows = [dict(r, aed_id=r["record_key"]) for r in rows]
+        aggregate.resource = _publish(dataset, aggregate.resource, merged_rows, names + MERGED_COLUMNS,
+                                      texts["list_title"], texts["list_description"], f"wykaz_{stem}.csv", "list-")
+        aggregate.full_resource = _publish(dataset, aggregate.full_resource, full_rows, names + FULL_COLUMNS,
+                                           texts["full_title"], texts["full_description"], f"wykaz_pelny_{stem}.csv", "full-")
+        if conflict_rows:
+            aggregate.conflicts_resource = _publish(
+                dataset, aggregate.conflicts_resource, conflict_rows, CONFLICT_COLUMNS, texts["conflicts_title"],
+                f"{texts['conflicts_description']} Wykaz z dnia {today}.", f"konflikty_{stem}.csv", "conflicts-")
+        if changes:
+            aggregate.changes_resource = _publish(
+                dataset, aggregate.changes_resource, changes, CHANGE_COLUMNS, texts["changes_title"],
+                f"{texts['changes_description']} Wykaz z dnia {today}.", f"zmiany_{stem}.csv", "changes-")
+
+        counts = {kind: sum(1 for c in changes if c["change"] == kind) for kind in ("added", "removed", "changed")}
+        aggregate.snapshot = snapshot
+        aggregate.stats = {
+            "rows": len(merged_rows),
+            "source_rows": len(rows),
+            "merged_devices": sum(1 for g in groups if len(g) > 1),
+            "possible_duplicates": flagged,
+            "conflicts": len(conflict_rows),
+            "unresolved_refs": unresolved,
+            "providers": providers,
+            "skipped": skipped,
+            "rules": {k: rules[k] for k in ("precedence_by_institution_type", "flag_distance_m", "conflict_distance_m")},
+            **counts,
+        }
+        aggregate.built_at = timezone.now()
+        aggregate.save()
+
+    logger.info("standards: %s list built: %s", standard, {k: v for k, v in aggregate.stats.items() if k != "providers"})
+    return aggregate
