+import logging
+
+from django.apps import apps
+
+from mcod.core.tasks import extended_shared_task
+
+logger = logging.getLogger("mcod")
+
+
+@extended_shared_task(name="mcod.standards.tasks.check_dataset_conformity_task")
+def check_dataset_conformity_task(dataset_id: int, remap: bool = False) -> dict:
+    """(Re)check every file of a dataset against the dataset's data standard (run after binding or changing it)."""
+    from mcod.standards.conformity import apply_standard_before_validation, check_resource
+
+    Resource = apps.get_model("resources", "Resource")
+    results = {}
+    for resource in Resource.raw.filter(dataset_id=dataset_id, is_removed=False):
+        if remap:
+            conformity = check_resource(resource, remap=True)
+            results[resource.pk] = conformity.status if conformity else None
+        else:
+            apply_standard_before_validation(resource)
+            conformity = getattr(Resource.raw.get(pk=resource.pk), "conformity", None)
+            results[resource.pk] = conformity.status if conformity else None
+    logger.info("standards: dataset %s conformity %s", dataset_id, results)
+    return results
+
+
+@extended_shared_task(name="mcod.standards.tasks.check_resource_conformity_task")
+def check_resource_conformity_task(resource_id: int, remap: bool = False):
+    from mcod.standards.conformity import check_resource
+
+    Resource = apps.get_model("resources", "Resource")
+    conformity = check_resource(Resource.raw.get(pk=resource_id), remap=remap)
+    return conformity.status if conformity else None
+
+
+@extended_shared_task(name="mcod.standards.tasks.build_standard_aggregates_task")
+def build_standard_aggregates_task(code: str = None) -> dict:
+    """(Re)build the national list of every active standard that has an owner (nightly, like the DGA list)."""
+    from mcod.standards.aggregate import build_aggregate
+    from mcod.standards.models import DataStandard
+
+    results = {}
+    standards = DataStandard.objects.filter(is_active=True, aggregate_owner__isnull=False)
+    if code:
+        standards = standards.filter(code=code)
+    for standard in standards:
+        try:
+            aggregate = build_aggregate(standard)
+            results[str(standard)] = aggregate.stats.get("rows")
+        except Exception as exc:
+            logger.exception("standards: national list for %s failed", standard)
+            results[str(standard)] = f"error: {exc}"
+    return results
