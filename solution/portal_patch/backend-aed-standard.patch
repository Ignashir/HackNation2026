@@ -0,0 +1,38 @@
+import json
+from pathlib import Path
+
+from django.conf import settings
+from django.core.management.base import BaseCommand, CommandError
+
+from mcod.standards.models import DataStandard
+
+
+class Command(BaseCommand):
+    help = "Create or update data standards from <root>/<code>/<version>/schema.json files (default root: data/standards)."
+
+    def add_arguments(self, parser):
+        parser.add_argument("--root", default=str(Path(str(settings.DATA_DIR)) / "standards"))
+
+    def handle(self, *args, **options):
+        root = Path(options["root"])
+        files = sorted(root.glob("*/*/schema.json"))
+        if not files:
+            raise CommandError(f"No */*/schema.json files under {root}")
+        for path in files:
+            definition = json.loads(path.read_text(encoding="utf-8"))
+            meta = definition.get("x-standard", {})
+            code, version = meta.get("code"), meta.get("version")
+            if not code or not version or not definition.get("fields"):
+                raise CommandError(f"{path}: needs x-standard.code, x-standard.version and fields")
+            if (code, version) != (path.parent.parent.name, path.parent.name):
+                raise CommandError(f"{path}: x-standard says {code}/{version}, directory says otherwise")
+            standard, created = DataStandard.objects.update_or_create(
+                code=code,
+                version=version,
+                defaults={
+                    "title": meta.get("title_pl") or meta.get("title_en") or code,
+                    "description": meta.get("description_pl", ""),
+                    "definition": definition,
+                },
+            )
+            self.stdout.write(f"{'created' if created else 'updated'}: {standard} ({len(standard.fields)} fields)")
