+            items.append(f"<li><b>{escape(', '.join(where))}</b> – {escape(e.get('message', ''))}</li>")
+        more = report.get("error_count", len(errors)) - min(len(errors), 20)
+        parts.append(
+            mark_safe(
+                f'<p style="color:#b91c1c"><b>Błędy ({report.get("error_count", len(errors))}):</b></p><ul>'
+                + "".join(items)
+                + (f"<li>… i {more} więcej</li>" if more > 0 else "")
+                + "</ul>"
+            )
+        )
+    return mark_safe("".join(str(p) for p in parts))
+
