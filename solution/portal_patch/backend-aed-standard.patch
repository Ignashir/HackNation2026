+++ b/mcod/standards/harvest.py
@@ -0,0 +1,76 @@
+"""
+Data standards in the harvester (XML feeds, XSD 1.14+).
+
+A feed binds a dataset to a standard with `<dataStandard code="aed" version="1.0"/>`. Files of a bound dataset follow
+the same rule as files uploaded in the admin panel: they are published only once they conform. A harvested file that
+is new, has a new URL, or has not been checked yet is saved as a draft with "publish once it conforms" and processed
+right away; the conformity check publishes it if it conforms. A file that does not conform stays a draft until the feed
+points to a corrected file.
+"""
+
+import logging
+from typing import Optional
+
+from mcod.standards.models import DataStandard, ResourceConformity
+
+logger = logging.getLogger("mcod")
+
+HOLD = "hold"  # keep as draft, nothing to do
+VERIFY = "verify"  # keep as draft and (re)check the file now
+
+
+def find_standard(ref: Optional[dict]) -> Optional[DataStandard]:
+    if not ref or not ref.get("code") or not ref.get("version"):
+        return None
+    return DataStandard.objects.filter(code=ref["code"], version=ref["version"], is_active=True).first()
+
+
+def other_dataset_with_standard(dataset_model, organization, standard, *, source_id=None, ext_ident=None, int_ident=None):
+    """One dataset per institution and standard: the institution's other dataset bound to it, if any."""
+    others = dataset_model.raw.filter(organization=organization, data_standard__code=standard.code, is_removed=False)
+    if int_ident:
+        others = others.exclude(pk=int_ident)
+    if source_id and ext_ident:
+        others = others.exclude(source_id=source_id, ext_ident=ext_ident)
+    return others.first()
+
+
+def gate_harvested_resource(resource_model, dataset, data: dict) -> Optional[str]:
+    """
+    Decide, before the harvester saves a resource, whether it must wait for the conformity check.
+
+    Changes `data["status"]` to draft when it must wait. Returns HOLD, VERIFY, or None (no standard, or the feed does not
+    publish the file).
+    """
+    standard = getattr(dataset, "data_standard", None)
+    if standard is None or data.get("status", "published") != "published":
+        return None
+
+    existing = None
+    if data.get("int_ident"):
+        existing = resource_model.raw.filter(dataset=dataset, id=data["int_ident"]).first()
+    elif data.get("ext_ident"):
+        existing = resource_model.raw.filter(dataset=dataset, ext_ident=data["ext_ident"]).first()
+    conformity = ResourceConformity.objects.filter(resource=existing).first() if existing else None
+
+    if existing is None or conformity is None or conformity.standard_id != standard.id or existing.link != data.get("link"):
+        decision = VERIFY
+    elif conformity.is_ok:
+        return None
+    else:
+        decision = HOLD  # same file as last time: pending (being checked) or does not conform
+
+    data["status"] = resource_model.STATUS.draft
+    return decision
+
+
+def after_harvested_resource(resource, decision: Optional[str]) -> None:
+    """Request the check (and publishing once it conforms) for a resource held by `gate_harvested_resource`."""
+    if decision != VERIFY or resource is None:
+        return
+    from mcod.standards.conformity import request_verification
+
+    try:
+        request_verification(resource)
+    except Exception:
+        logger.exception("standards: cannot request verification of harvested resource %s", resource.pk)
