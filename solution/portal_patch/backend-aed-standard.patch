+            "<th>Pole standardu</th><th>Poziom</th><th>Kolumna w pliku</th><th>Jak przypisano</th><th>Przykład</th>"
+            "</tr></thead><tbody>" + "".join(rows) + "</tbody></table>"
+        )
+    )
+
+    errors = report.get("errors", [])
+    if errors:
+        labels = {f["name"]: standard.annotation(f).get("label_pl", f["name"]) for f in standard.fields}
+        items = []
+        for e in errors[:20]:
+            where = [f"wiersz {e['row']}"] if e.get("row") else []
+            if e.get("field"):
