+    def _validate_data_standard(self, cleaned_data: Dict[str, Any]) -> None:
+        """One dataset per institution and data standard (e.g. one AED register per institution)."""
+        standard = cleaned_data.get("data_standard")
+        if not standard:
+            return
+        organization = cleaned_data.get("organization") or getattr(self.instance, "organization", None)
+        if not organization:
+            return
+        others = Dataset.raw.filter(organization=organization, data_standard__code=standard.code, is_removed=False)
