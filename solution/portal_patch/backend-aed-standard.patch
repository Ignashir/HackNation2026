@@ -0,0 +1,146 @@
+from django.contrib.postgres.fields import JSONField
+from django.db import models
+from django.utils.translation import gettext_lazy as _
+
+
+class DataStandard(models.Model):
+    """
+    A versioned data standard (e.g. "aed" 1.0).
+
+    `definition` is a Frictionless Table Schema with standard-specific annotations (`x-standard`, per-field `x-<code>`):
+    labels, descriptions, examples and header synonyms. Datasets bound to a standard (`Dataset.data_standard`) only
+    accept files that conform to it.
+    """
+
+    code = models.SlugField(max_length=50, verbose_name=_("code"))
+    version = models.CharField(max_length=20, verbose_name=_("version"))
+    title = models.CharField(max_length=255, verbose_name=_("title"))
+    description = models.TextField(blank=True, verbose_name=_("description"))
+    definition = JSONField(verbose_name=_("definition (Table Schema)"))
+    is_active = models.BooleanField(default=True, verbose_name=_("active"))
+    aggregate_owner = models.ForeignKey(
+        "organizations.Organization",
+        on_delete=models.SET_NULL,
+        null=True,
+        blank=True,
+        related_name="aggregated_standards",
+        verbose_name=_("national list owner"),
+        help_text=_("Coordinating institution that publishes the combined list of all conforming files."),
+    )
+    created = models.DateTimeField(auto_now_add=True)
+    modified = models.DateTimeField(auto_now=True)
+
+    class Meta:
+        verbose_name = _("data standard")
+        verbose_name_plural = _("data standards")
+        ordering = ("code", "version")
+        constraints = [models.UniqueConstraint(fields=("code", "version"), name="standards_code_version_uq")]
+
+    def __str__(self):
+        return f"{self.title} (v{self.version})"
+
+    @property
+    def fields(self):
+        return self.definition.get("fields", [])
+
+    @property
+    def annotation_key(self):
+        return f"x-{self.code}"
+
+    def annotation(self, field):
+        return field.get(self.annotation_key, {})
+
+    @property
+    def required_fields(self):
+        return [f["name"] for f in self.fields if f.get("constraints", {}).get("required")]
+
+    @property
+    def portal_geo(self):
+        """Standard field names to use for the portal's map roles, e.g. {"l": "lon", "b": "lat", "label": "name"}."""
+        return self.definition.get("x-standard", {}).get("portal_geo", {})
+
+
+class ResourceConformity(models.Model):
+    """
+    Conformity of one resource (file) with the standard its dataset is bound to.
+
+    The column mapping lives here rather than in `Resource.tabular_data_schema`, because the portal regenerates that
+    schema whenever the file is re-processed.
+    """
+
+    STATUS_PENDING = "pending"
+    STATUS_OK = "ok"
+    STATUS_UNMAPPED = "unmapped"
+    STATUS_ERRORS = "errors"
+    STATUS_NOT_TABULAR = "not_tabular"
+    STATUS_CHOICES = (
+        (STATUS_PENDING, _("Waiting for verification")),
+        (STATUS_OK, _("Conforms to the standard")),
+        (STATUS_UNMAPPED, _("Required columns are not mapped")),
+        (STATUS_ERRORS, _("Data does not conform")),
+        (STATUS_NOT_TABULAR, _("Not a tabular file")),
+    )
+
+    resource = models.OneToOneField(
+        "resources.Resource", on_delete=models.CASCADE, related_name="conformity", verbose_name=_("resource")
+    )
+    standard = models.ForeignKey(DataStandard, on_delete=models.PROTECT, verbose_name=_("standard"))
+    status = models.CharField(max_length=20, choices=STATUS_CHOICES, default=STATUS_PENDING, verbose_name=_("status"))
+    # {standard_field: {"col_name": str, "col_index": int, "method": "exact|synonym|detected|manual"}}
+    mapping = JSONField(default=dict, blank=True, verbose_name=_("column mapping"))
+    mapping_confirmed = models.BooleanField(default=False, verbose_name=_("mapping confirmed by the editor"))
+    # {"missing_required": [...], "errors": [{"code", "message", "row", "column"}], "error_count": int}
+    report = JSONField(default=dict, blank=True, verbose_name=_("report"))
+    publish_requested = models.BooleanField(
+        default=False, verbose_name=_("publish when verified"),
+        help_text=_("The editor chose to publish; the file is published automatically once it conforms."),
+    )
+    checked_at = models.DateTimeField(null=True, blank=True, verbose_name=_("checked at"))
+
+    class Meta:
+        verbose_name = _("resource conformity")
+        verbose_name_plural = _("resource conformity")
+
+    def __str__(self):
+        return f"{self.resource_id}: {self.status}"
+
+    @property
+    def is_ok(self):
+        return self.status == self.STATUS_OK
+
+
+class StandardAggregate(models.Model):
+    """
+    The combined list of a standard (e.g. "Krajowy wykaz AED"): one dataset owned by the coordinating institution with
+    two files whose ids stay stable between runs: the list itself and the changes since the previous run.
+    """
+
+    standard = models.OneToOneField(DataStandard, on_delete=models.CASCADE, related_name="aggregate")
+    dataset = models.ForeignKey("datasets.Dataset", on_delete=models.SET_NULL, null=True, blank=True, related_name="+")
+    resource = models.ForeignKey("resources.Resource", on_delete=models.SET_NULL, null=True, blank=True, related_name="+")
+    changes_resource = models.ForeignKey(
+        "resources.Resource", on_delete=models.SET_NULL, null=True, blank=True, related_name="+"
+    )
+    full_resource = models.ForeignKey(
+        "resources.Resource", on_delete=models.SET_NULL, null=True, blank=True, related_name="+"
+    )
+    conflicts_resource = models.ForeignKey(
+        "resources.Resource", on_delete=models.SET_NULL, null=True, blank=True, related_name="+"
+    )
+    # {record_key: [row_hash, name, lat, lon]} of the last published list, used to compute changes.
+    snapshot = JSONField(default=dict, blank=True)
+    # {"rows", "providers": [...], "added", "removed", "changed", "skipped": [...]}
+    stats = JSONField(default=dict, blank=True)
+    built_at = models.DateTimeField(null=True, blank=True)
+
+    class Meta:
+        verbose_name = _("national list")
+        verbose_name_plural = _("national lists")
+
+    def __str__(self):
+        return f"{self.standard}: {self.stats.get('rows', 0)} rows"
+
+    @property
+    def published_resource(self):
+        r = self.resource
+        return r if r and r.status == "published" and not r.is_removed else None
