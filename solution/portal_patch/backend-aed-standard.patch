+import falcon
+
+from mcod.core.api import fields
+from mcod.core.api.handlers import BaseHdlr
+from mcod.core.api.hooks import login_optional
+from mcod.core.api.schemas import ExtSchema
+from mcod.core.api.views import JsonAPIView
+from mcod.core.versioning import versioned
+from mcod.standards.models import StandardAggregate
+
+
+class ProviderStatsSchema(ExtSchema):
+    provider = fields.Str()
+    provider_id = fields.Int()
+    dataset_id = fields.Int()
+    resource_id = fields.Int()
+    rows = fields.Int()
+    precedence = fields.Int()
+
+
+class StandardAggregateApiResponse(ExtSchema):
+    standard = fields.Str(attribute="standard.code")
+    version = fields.Str(attribute="standard.version")
+    title = fields.Str(attribute="standard.title")
+    owner = fields.Str(attribute="standard.aggregate_owner.title")
+    dataset_id = fields.Int(attribute="dataset.id")
+    dataset_slug = fields.Str(attribute="dataset.slug")
+    resource_id = fields.Int(attribute="resource.id")
+    resource_slug = fields.Str(attribute="resource.slug")
+    changes_resource_id = fields.Int(attribute="changes_resource.id", allow_none=True)
+    full_resource_id = fields.Int(attribute="full_resource.id", allow_none=True)
+    conflicts_resource_id = fields.Int(attribute="conflicts_resource.id", allow_none=True)
+    rows = fields.Int(attribute="stats.rows")
+    source_rows = fields.Int(attribute="stats.source_rows")
+    merged_devices = fields.Int(attribute="stats.merged_devices")
+    possible_duplicates = fields.Int(attribute="stats.possible_duplicates")
+    conflicts = fields.Int(attribute="stats.conflicts")
+    added = fields.Int(attribute="stats.added")
+    changed = fields.Int(attribute="stats.changed")
+    removed = fields.Int(attribute="stats.removed")
+    providers = fields.Nested(ProviderStatsSchema, attribute="stats.providers", many=True)
+    built_at = fields.DateTime(attribute="built_at")
+
+
+class StandardAggregateView(JsonAPIView):
+    """The national (combined) list of a data standard, e.g. /standards/aed/aggregated."""
+
+    @falcon.before(login_optional)
+    @versioned
+    def on_get(self, request, response, *args, **kwargs):
+        self.handle(request, response, self.GET, *args, **kwargs)
+
+    class GET(BaseHdlr):
+        database_model = StandardAggregate
+        serializer_schema = StandardAggregateApiResponse
+
+        def _get_data(self, cleaned, *args, **kwargs):
+            code = kwargs.get("code")
+            aggregate = (
+                StandardAggregate.objects.select_related(
+                    "standard", "standard__aggregate_owner", "dataset", "resource", "changes_resource", "full_resource", "conflicts_resource"
+                )
+                .filter(standard__code=code, standard__is_active=True)
+                .order_by("-standard__version")
+                .first()
+            )
+            if aggregate is None or aggregate.published_resource is None:
+                raise falcon.HTTPNotFound
+            return aggregate
+
+        def serialize(self, *args, **kwargs):
+            self.prepare_context(*args, **kwargs)
+            return self.serializer.dump(self.response.context.data)
