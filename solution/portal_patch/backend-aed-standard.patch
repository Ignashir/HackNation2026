+++ b/mcod/standards/conformity.py
@@ -0,0 +1,548 @@
+"""
+Conformity of resources (files) with the data standard their dataset is bound to.
+
+Deterministic only, no AI: column mapping comes from exact names, then the standard's header synonyms, then simple
+value checks (Poland's coordinate ranges). AI-assisted mapping is a third-party tool's job; its output uses the
+standard's exact column names, which map here with no further input.
+"""
+
+import csv
+import json
+import logging
+import os
+import re
+import tempfile
+import unicodedata
+from typing import Dict, List, Optional
+
+from django.db import transaction
+from django.utils import timezone
+from goodtables import validate as validate_table
+from tableschema import Table
+
+from mcod.standards.models import DataStandard, ResourceConformity
+
+logger = logging.getLogger("mcod")
+
+SAMPLE_ROWS = 200
+ERROR_LIMIT = 50
+# Value ranges used to recognise coordinate columns in Poland (must stay in line with the standard's constraints).
+LAT_RANGE = (49.0, 54.9)
+LON_RANGE = (14.1, 24.2)
+_POLISH = str.maketrans("łŁ", "lL")
+
+
+def normalize_header(value: str) -> str:
+    """'Długość_geograficzna ' -> 'dlugosc geograficzna'."""
+    value = unicodedata.normalize("NFKD", str(value).translate(_POLISH))
+    value = "".join(ch for ch in value if not unicodedata.combining(ch)).lower()
+    return re.sub(r"[\s_\-./]+", " ", value).strip()
+
+
+# --- mapping ---------------------------------------------------------------
+
+
+def suggest_mapping(standard: DataStandard, headers: List[str], sample: Optional[List[list]] = None) -> Dict[str, dict]:
+    """
+    Map the provider's columns to standard fields.
+
+    Returns {standard_field: {"col_name", "col_index", "method"}}; each column and each field is used at most once.
+    """
+    mapping: Dict[str, dict] = {}
+    used_cols = set()
+    normalized = [normalize_header(h) for h in headers]
+    sample = sample or []
+
+    def assign(field_name, index, method, **extra):
+        mapping[field_name] = {"col_name": headers[index], "col_index": index, "method": method, **extra}
+        used_cols.add(index)
+
+    def best(candidates):
+        # Among several matching columns prefer the most varied one: a "Nazwa" column that says "Defibrylator" in
+        # every row should lose to a "Lokalizacja" column with real place names.
+        if len(candidates) == 1 or not sample:
+            return candidates[0]
+        return max(candidates, key=lambda i: (len(set(_column_values(sample, i))), -i))
+
+    # 1. exact standard names (files produced by the converter, or already in the standard's format)
+    for field in standard.fields:
+        name = normalize_header(field["name"])
+        candidates = [i for i, header in enumerate(normalized) if i not in used_cols and header == name]
+        if candidates:
+            assign(field["name"], candidates[0], "exact")
+
+    # 2. header synonyms from the standard's definition
+    for field in standard.fields:
+        if field["name"] in mapping:
+            continue
+        synonyms = {normalize_header(s) for s in standard.annotation(field).get("synonyms", [])}
+        candidates = [i for i, header in enumerate(normalized) if i not in used_cols and header in synonyms]
+        if candidates:
+            assign(field["name"], best(candidates), "synonym")
+
+    # 3. coordinates recognised by their values, swapped lat/lon detected, or one "point" column (GeoJSON-like)
+    if sample:
+        _detect_coordinates(mapping, headers, sample, used_cols, assign)
+        if "lat" not in mapping and "lon" not in mapping:
+            _detect_point(standard, mapping, headers, normalized, sample, used_cols)
+
+    return mapping
+
+
+_NUM = r"-?\d+(?:[.,]\d+)?"
+_POINT_TEXT = re.compile(rf"^\s*\(?\s*({_NUM})\s*[,; ]\s*({_NUM})\s*\)?\s*$")
+
+
+def parse_point(value):
+    """
+    (lat, lon) from a point value, or None.
+
+    Accepts GeoJSON {"type":"Point","coordinates":[lon,lat]}, the {"lat":..,"long"/"lon"/"lng":..} variant (also nested
+    in "coordinates"), and the text "lat, lon". Text pairs are ordered by Poland's ranges, so "21.7, 49.7" also works.
+    """
+    if value in (None, "", "-"):
+        return None
+    obj = value
+    if isinstance(value, str):
+        text = value.strip()
+        if text.startswith("{") or text.startswith("["):
+            try:
+                obj = json.loads(text)
+            except ValueError:
+                return None
+        else:
+            match = _POINT_TEXT.match(text)
+            if not match:
+                return None
+            a, b = (float(x.replace(",", ".")) for x in match.groups())
+            return (b, a) if _in(a, LON_RANGE) and _in(b, LAT_RANGE) else (a, b)
+    try:
+        if isinstance(obj, dict) and "coordinates" in obj:
+            obj = obj["coordinates"]
+        if isinstance(obj, dict):
+            lat = obj.get("lat") or obj.get("latitude")
+            lon = obj.get("lon") or obj.get("long") or obj.get("lng") or obj.get("longitude")
+            return (float(lat), float(lon)) if lat is not None and lon is not None else None
+        if isinstance(obj, (list, tuple)) and len(obj) >= 2:
+            return float(obj[1]), float(obj[0])  # GeoJSON order: [lon, lat]
+    except (TypeError, ValueError):
+        return None
+    return None
+
+
+def _in(number, value_range):
+    return value_range[0] <= number <= value_range[1]
+
+
+def _detect_point(standard, mapping, headers, normalized, sample, used_cols):
+    point = standard.definition.get("x-standard", {}).get("composite_inputs", {}).get("point")
+    if not point:
+        return
+    synonyms = {normalize_header(s) for s in point.get("synonyms", [])}
+    order = sorted(range(len(headers)), key=lambda i: normalized[i] not in synonyms)  # synonym columns first
+    for i in order:
+        if i in used_cols:
+            continue
+        values = _column_values(sample, i)
+        points = [parse_point(v) for v in values]
+        inside = [p for p in points if p and _in(p[0], LAT_RANGE) and _in(p[1], LON_RANGE)]
+        if len(values) >= 3 and len(inside) / len(values) > 0.9:
+            for field_name in ("lat", "lon"):
+                mapping[field_name] = {"col_name": headers[i], "col_index": i, "method": "point", "part": field_name}
+            used_cols.add(i)
+            return
+
+
+def _numeric_share_in(values, low, high):
+    numbers = []
+    for v in values:
+        try:
+            numbers.append(float(str(v).replace(",", ".")))
+        except (TypeError, ValueError):
+            continue
+    if not numbers:
+        return 0.0
+    return sum(low <= n <= high for n in numbers) / len(numbers)
+
+
+def _column_values(sample, index):
+    return [row[index] for row in sample if index < len(row) and row[index] not in (None, "", "-")]
+
+
+def _detect_coordinates(mapping, headers, sample, used_cols, assign):
+    # A header that says "latitude" over values that are longitudes (or the reverse): the columns are swapped.
+    lat, lon = mapping.get("lat"), mapping.get("lon")
+    if lat and lon:
+        lat_values, lon_values = _column_values(sample, lat["col_index"]), _column_values(sample, lon["col_index"])
+        if _numeric_share_in(lat_values, *LON_RANGE) > 0.9 and _numeric_share_in(lon_values, *LAT_RANGE) > 0.9:
+            for item in (lat, lon):
+                item["swap_suspected"] = True
+        return
+
+    for field_name, value_range in (("lat", LAT_RANGE), ("lon", LON_RANGE)):
+        if field_name in mapping:
+            continue
+        for i in range(len(headers)):
+            if i in used_cols:
+                continue
+            values = _column_values(sample, i)
+            if len(values) >= 3 and _numeric_share_in(values, *value_range) > 0.95:
+                assign(field_name, i, "detected")
+                break
+
+
+# --- normalization and validation --------------------------------------------
+
+
+def _open_table(resource):
+    data = resource.data
+    return Table(
+        resource.file_data_path,
+        ignore_blank_headers=True,
+        format=data.resource_format,
+        encoding=data.resource_encoding or "utf-8",
+        skip_rows={"type": "preset", "value": "blank"},
+    )
+
+
+def _read_sample(resource):
+    table = _open_table(resource)
+    rows = table.read(limit=SAMPLE_ROWS)
+    return [str(h) for h in (table.headers or [])], rows
+
+
+def _cell(value):
+    if value is None:
+        return ""
+    if isinstance(value, (dict, list)):
+        return json.dumps(value, ensure_ascii=False)
+    return str(value).strip()
+
+
+def normalize_rows(resource, standard: DataStandard, mapping: Dict[str, dict]):
+    """
+    Yield the file's rows in the standard's columns (text values, as written by the provider; no repairs).
+
+    Columns mapped as a "point" give lat/lon extracted from that column. Unmapped standard columns are empty.
+    """
+    names = [f["name"] for f in standard.fields]
+    for row in _open_table(resource).iter():
+        out = dict.fromkeys(names, "")
+        for field_name, item in mapping.items():
+            index = item["col_index"]
+            raw = row[index] if index < len(row) else None
+            if item.get("method") == "point":
+                point = parse_point(raw)
+                out[field_name] = "" if point is None else repr(point[0] if item.get("part") == "lat" else point[1])
+            else:
+                out[field_name] = _cell(raw)
+        yield out
+
+
+def _validation_schema(standard: DataStandard) -> dict:
+    return {
+        "fields": [{k: v for k, v in f.items() if not k.startswith("x-")} for f in standard.fields],
+        "primaryKey": standard.definition.get("primaryKey"),
+        "missingValues": standard.definition.get("missingValues", [""]),
+    }
+
+
+def validate_normalized(resource, standard: DataStandard, mapping: Dict[str, dict]):
+    """Validate the normalized rows against the standard with goodtables (the portal's own validator)."""
+    names = [f["name"] for f in standard.fields]
+    fd, path = tempfile.mkstemp(suffix=".csv", prefix="standard-")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="") as fh:
+            writer = csv.DictWriter(fh, fieldnames=names, lineterminator="\n")
+            writer.writeheader()
+            rows = 0
+            for row in normalize_rows(resource, standard, mapping):
+                writer.writerow(row)
+                rows += 1
+        report = validate_table(
+            path,
+            schema=_validation_schema(standard),
+            checks=["structure", "schema"],
+            skip_checks=["blank-row", "duplicate-row"],
+            error_limit=ERROR_LIMIT,
+            format="csv",
+            encoding="utf-8",
+        )
+    finally:
+        os.unlink(path)
+
+    table = report["tables"][0] if report.get("tables") else {}
+    errors = []
+    for e in table.get("errors", []):
+        col = e.get("column-number")
+        field_name = names[col - 1] if col and 0 < col <= len(names) else None
+        source = mapping.get(field_name, {}).get("col_name") if field_name else None
+        errors.append(
+            {
+                "code": e.get("code"),
+                "message": e.get("message"),
+                "row": e.get("row-number"),
+                "field": field_name,
+                "source_column": source,
+            }
+        )
+    if rows == 0:
+        errors.append({"code": "zero-data-rows", "message": "Brak wierszy z danymi", "row": None})
+    return report.get("valid", False) and rows > 0, errors, table.get("error-count", len(errors)), rows
+
+
+# --- entry points ------------------------------------------------------------
+
+
+def get_standard(resource) -> Optional[DataStandard]:
+    dataset = getattr(resource, "dataset", None)
+    return getattr(dataset, "data_standard", None) if dataset else None
+
+
+def check_resource(resource, *, remap: bool = False) -> Optional[ResourceConformity]:
+    """
+    Check one resource against its dataset's standard and store the result.
+
+    Returns None when the dataset is not bound to a standard. Never raises for data problems: they end up in the report.
+    """
+    standard = get_standard(resource)
+    if standard is None:
+        ResourceConformity.objects.filter(resource=resource).delete()
+        return None
+
+    conformity, _ = ResourceConformity.objects.get_or_create(resource=resource, defaults={"standard": standard})
+    if conformity.standard_id != standard.id:
+        conformity.standard, conformity.mapping, conformity.mapping_confirmed = standard, {}, False
+
+    if not resource.has_tabular_format() or not resource.main_file:
+        conformity.status, conformity.report = ResourceConformity.STATUS_NOT_TABULAR, {}
+        return _save(conformity)
+
+    try:
+        headers, sample = _read_sample(resource)
+    except Exception as exc:  # unreadable file: report it instead of failing the processing task
+        logger.exception("standards: cannot read resource %s", resource.pk)
+        conformity.status = ResourceConformity.STATUS_ERRORS
+        conformity.report = {"errors": [{"code": "unreadable", "message": str(exc)}], "error_count": 1}
+        return _save(conformity)
+
+    if remap or not conformity.mapping or not _mapping_fits(conformity.mapping, headers):
+        conformity.mapping = suggest_mapping(standard, headers, sample)
+        conformity.mapping_confirmed = False
+    else:
+        # A file can gain columns (e.g. a new optional field of the standard): map those named exactly like an
+        # unmapped standard field, even in a confirmed mapping (an exact name is unambiguous).
+        used = {item["col_index"] for item in conformity.mapping.values()}
+        by_name = {normalize_header(h): i for i, h in enumerate(headers) if i not in used}
+        for field in standard.fields:
+            index = by_name.get(normalize_header(field["name"]))
+            if field["name"] not in conformity.mapping and index is not None:
+                conformity.mapping[field["name"]] = {"col_name": headers[index], "col_index": index, "method": "exact"}
+
+    report = {"headers": headers, "missing_required": [], "warnings": [], "errors": [], "error_count": 0}
+    report["missing_required"] = [f for f in standard.required_fields if f not in conformity.mapping]
+    report["warnings"] = _warnings(standard, headers, conformity.mapping, sample)
+
+    if report["missing_required"]:
+        conformity.status = ResourceConformity.STATUS_UNMAPPED
+    else:
+        try:
+            valid, errors, count, rows = validate_normalized(resource, standard, conformity.mapping)
+        except Exception as exc:  # goodtables can raise on some values (e.g. CastError) instead of reporting them
+            logger.exception("standards: validation of resource %s raised", resource.pk)
+            valid, errors, count, rows = False, [{"code": "validation-error", "message": str(exc)[:500], "row": None}], 1, None
+        report["errors"], report["error_count"], report["rows"] = errors, count, rows
+        conformity.status = ResourceConformity.STATUS_OK if valid else ResourceConformity.STATUS_ERRORS
+
+    conformity.report = report
+    _save(conformity)
+    if conformity.is_ok:
+        apply_portal_geo_mapping(resource, standard, conformity.mapping)
+        if conformity.publish_requested:
+            publish_conforming(resource, conformity)
+    return conformity
+
+
+TYPE_KEYS = ("type", "format", "trueValues", "falseValues")
+
+
+def apply_standard_types(resource, standard, mapping) -> bool:
+    """
+    Give mapped columns the standard's type in the portal's own schema (`tabular_data_schema`).
+
+    The portal guesses types from samples, e.g. a phone column with mostly empty cells becomes "integer" and then fails
+    the portal's generic validation. For a bound dataset the standard is authoritative.
+    Returns True if the schema changed.
+    """
+    from mcod.resources.models import Resource
+
+    tds = resource.tabular_data_schema or {}
+    fields = tds.get("fields") or []
+    std_fields = {f["name"]: f for f in standard.fields}
+    changed = False
+    for field_name, item in mapping.items():
+        index = item["col_index"]
+        if index >= len(fields) or field_name not in std_fields:
+            continue
+        if item.get("method") == "point":
+            # lat/lon are extracted by the standard; keep the source column as text. The portal guesses JSON points as
+            # "object", which its search indexing cannot handle (KeyError: 'object').
+            wanted = {"type": "string", "format": "default"}
+            if any(fields[index].get(k) != v for k, v in wanted.items()):
+                fields[index].update(wanted)
+                changed = True
+            continue
+        wanted = {k: std_fields[field_name][k] for k in TYPE_KEYS if k in std_fields[field_name]}
+        wanted.setdefault("format", "default")
+        if wanted["type"] == "boolean":
+            # The portal's indexer sends cell text as-is to an Elasticsearch boolean field, ignoring trueValues, so
+            # "tak"/"nie" would fail indexing. The standard check validates booleans; the portal keeps them as text.
+            wanted = {"type": "string", "format": "default"}
+        for key in ("trueValues", "falseValues"):
+            if key not in wanted and key in fields[index]:
+                del fields[index][key]
+                changed = True
+        if any(fields[index].get(k) != v for k, v in wanted.items()):
+            fields[index].update(wanted)
+            changed = True
+    # With the standard's types (boolean, date…) an empty optional cell must count as "missing", as the standard says;
+    # the portal otherwise only accepts its special signs there and rejects the whole file.
+    missing = list(dict.fromkeys((tds.get("missingValues") or []) + standard.definition.get("missingValues", [""])))
+    if mapping and missing != tds.get("missingValues"):
+        tds["missingValues"] = missing
+        changed = True
+    if changed:
+        Resource.raw.filter(pk=resource.pk).update(tabular_data_schema=tds)
+        resource.tabular_data_schema = tds
+    return changed
+
+
+def apply_standard_before_validation(resource) -> bool:
+    """
+    Hook for the file-processing task: check conformity and align column types with the standard.
+
+    Never raises: a failure here must not break the portal's normal processing. Returns True if the resource's schema
+    was changed (callers should reload the resource).
+    """
+    try:
+        conformity = check_resource(resource)
+        if conformity and conformity.mapping:
+            return apply_standard_types(resource, conformity.standard, conformity.mapping)
+    except Exception:
+        logger.exception("standards: conformity check failed for resource %s", resource.pk)
+    return False
+
+
+def _mapping_fits(mapping, headers):
+    return all(
+        item["col_index"] < len(headers) and headers[item["col_index"]] == item["col_name"] for item in mapping.values()
+    )
+
+
+GENERIC_NAMES = {"defibrylator", "aed", "defibrylator aed", "defibrillator"}
+
+
+def _warnings(standard, headers, mapping, sample=None):
+    warnings = []
+    name = mapping.get("name")
+    if name and sample:
+        values = [normalize_header(v) for v in _column_values(sample, name["col_index"])]
+        if values and sum(v in GENERIC_NAMES for v in values) / len(values) > 0.5:
+            warnings.append(
+                {
+                    "code": "generic-name",
+                    "message": f"Kolumna „{name['col_name']}” zawiera głównie słowo „Defibrylator” – nazwa miejsca "
+                    "powinna wskazywać obiekt (np. szkoła, urząd).",
+                }
+            )
+    single = len(headers) == 1 and any(sep in headers[0] for sep in (",", ";", "\t"))
+    if single:
+        warnings.append(
+            {
+                "code": "single-column-delimited",
+                "message": "Plik ma jedną kolumnę, której nagłówek zawiera separatory – prawdopodobnie cały wiersz "
+                "jest ujęty w cudzysłów. Popraw formatowanie CSV.",
+            }
+        )
+    if any(item.get("swap_suspected") for item in mapping.values()):
+        warnings.append(
+            {
+                "code": "coordinates-swapped",
+                "message": "Wartości w kolumnie szerokości geograficznej wyglądają na długość (i odwrotnie) – "
+                "prawdopodobnie kolumny są zamienione.",
+            }
+        )
+    return warnings
+
+
+def _save(conformity):
+    conformity.checked_at = timezone.now()
+    conformity.save()
+    return conformity
+
+
+def apply_portal_geo_mapping(resource, standard, mapping):
+    """Fill the portal's own map roles (Maps and plots) from the standard mapping, if the editor has not set them."""
+    from mcod.resources.models import Resource
+
+    tds = resource.tabular_data_schema or {}
+    if not tds.get("fields") or tds.get("geo"):
+        return
+    geo = {}
+    for role, field_name in standard.portal_geo.items():
+        item = mapping.get(field_name)
+        if not item or item.get("method") == "point" or item["col_index"] >= len(tds["fields"]):
+            return  # the portal's own map needs separate lon/lat columns
+        geo[role] = {"col_name": tds["fields"][item["col_index"]]["name"], "col_index": item["col_index"]}
+    for role, item in geo.items():
+        tds["fields"][item["col_index"]]["geo"] = role
+    tds["geo"] = geo
+    Resource.raw.filter(pk=resource.pk).update(tabular_data_schema=tds)
+    resource.tabular_data_schema = tds
+
+
+def set_manual_mapping(resource, mapping: Dict[str, dict], *, reprocess: bool = True):
+    """Store a mapping confirmed by the editor and (by default) reprocess the file, so types and checks follow it."""
+    standard = get_standard(resource)
+    if standard is None:
+        return None
+    conformity, _ = ResourceConformity.objects.get_or_create(resource=resource, defaults={"standard": standard})
+    conformity.standard = standard
+    conformity.mapping = mapping
+    conformity.mapping_confirmed = True
+    conformity.status = ResourceConformity.STATUS_PENDING
+    conformity.save()
+    if reprocess:
+        resource.revalidate()
+    return conformity
+
+
+def request_verification(resource):
+    """
+    Mark a draft as "publish once it conforms" and make the portal process its file now.
+
+    The portal only processes new files of published resources (`process_created_file`), while a file in a dataset bound
+    to a standard stays a draft until it conforms, so processing is requested explicitly.
+    """
+    standard = get_standard(resource)
+    if standard is None:
+        return None
+    conformity, _ = ResourceConformity.objects.update_or_create(
+        resource=resource,
+        defaults={"standard": standard, "status": ResourceConformity.STATUS_PENDING, "publish_requested": True},
+    )
+    resource.revalidate()
+    return conformity
+
+
+def publish_conforming(resource, conformity):
+    """Publish a file the editor asked to publish, now that it conforms."""
+    conformity.publish_requested = False
+    conformity.save(update_fields=["publish_requested"])
+    if resource.status != resource.STATUS.published:
+        resource.status = resource.STATUS.published
+
+        def _publish():
+            resource.save(update_fields=["status"])
+
+        transaction.on_commit(_publish)
