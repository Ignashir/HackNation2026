@@ -0,0 +1,88 @@
+import json
+
+from django import forms
+from django.utils.html import escape
+
+from mcod.standards.models import ResourceConformity
+
+PREFIX = "std_map__"
+LEVEL_LABEL = {"required": "wymagane", "recommended": "zalecane", "optional": "opcjonalne"}
+
+
+def encode(item) -> str:
+    """Mapping item -> select value: "col:<index>", "point:<index>" or "" (not mapped)."""
+    if not item:
+        return ""
+    return f"{'point' if item.get('method') == 'point' else 'col'}:{item['col_index']}"
+
+
+def decode(choices: dict, headers: list) -> dict:
+    """{field: "col:3" | "point:7" | ""} -> mapping {field: {col_name, col_index, method, manual}}."""
+    mapping = {}
+    for field_name, value in choices.items():
+        if not value or ":" not in value:
+            continue
+        kind, index = value.split(":", 1)
+        index = int(index)
+        if not 0 <= index < len(headers):
+            continue
+        item = {"col_name": headers[index], "col_index": index, "method": "manual", "manual": True}
+        if kind == "point" and field_name in ("lat", "lon"):
+            item.update(method="point", part=field_name)
+        mapping[field_name] = item
+    return mapping
+
+
+class StandardMappingWidget(forms.Widget):
+    """One select per standard field, listing the file's columns. Pre-filled with the current (suggested) mapping."""
+
+    instance = None  # the resource, set by the form
+
+    def headers(self):
+        conformity = ResourceConformity.objects.filter(resource=self.instance).first() if self.instance else None
+        headers = (conformity.report or {}).get("headers") if conformity else None
+        if not headers:
+            headers = [f.get("name", "") for f in (getattr(self.instance, "tabular_data_schema", None) or {}).get("fields", [])]
+        return conformity, headers
+
+    def render(self, name, value, attrs=None, renderer=None):
+        standard = getattr(getattr(self.instance, "dataset", None), "data_standard", None)
+        if not standard:
+            return ""
+        conformity, headers = self.headers()
+        if not headers:
+            return "<p>Kolumny pliku będą dostępne po jego przetworzeniu.</p>"
+        mapping = (conformity.mapping if conformity else None) or {}
+        rows = []
+        for field in standard.fields:
+            ann = standard.annotation(field)
+            current = encode(mapping.get(field["name"]))
+            options = ['<option value="">— nie przypisano —</option>']
+            for i, header in enumerate(headers):
+                value_ = f"col:{i}"
+                selected = " selected" if value_ == current else ""
+                options.append(f'<option value="{value_}"{selected}>{escape(header)}</option>')
+            if field["name"] in ("lat", "lon"):
+                for i, header in enumerate(headers):
+                    value_ = f"point:{i}"
+                    selected = " selected" if value_ == current else ""
+                    options.append(f'<option value="{value_}"{selected}>punkt z kolumny: {escape(header)}</option>')
+            level = ann.get("level", "")
+            bold = ' style="font-weight:600"' if level == "required" else ""
+            rows.append(
+                f"<tr{bold}><td>{escape(ann.get('label_pl', field['name']))}<br><code>{escape(field['name'])}</code></td>"
+                f"<td>{LEVEL_LABEL.get(level, level)}</td>"
+                f'<td><select name="{PREFIX}{escape(field["name"])}" style="min-width:260px">{"".join(options)}</select></td>'
+                f"<td><small>{escape(ann.get('description_pl', ''))}</small></td></tr>"
+            )
+        confirmed = " (zatwierdzone ręcznie)" if conformity and conformity.mapping_confirmed else ""
+        return (
+            f"<p><b>Przypisanie kolumn pliku do pól standardu</b>{confirmed}. Zmień wybór, jeśli podpowiedź jest błędna, "
+            "i zapisz – plik zostanie ponownie sprawdzony.</p>"
+            '<table class="table table-condensed" style="max-width:1300px"><thead><tr><th>Pole standardu</th>'
+            "<th>Poziom</th><th>Kolumna w pliku</th><th>Opis</th></tr></thead><tbody>" + "".join(rows) + "</tbody></table>"
+        )
+
+    def value_from_datadict(self, data, files, name):
+        choices = {key[len(PREFIX):]: data.get(key, "") for key in data if key.startswith(PREFIX)}
+        return json.dumps(choices) if choices else None
