+    "Najczęściej cały wiersz jest ujęty w cudzysłów. Popraw formatowanie pliku CSV."
+)
+_SEPARATORS = (",", ";", "\t", "|")
+
+
+def _looks_delimited(value) -> bool:
+    text = str(value or "")
+    return any(text.count(sep) >= 2 for sep in _SEPARATORS)
+
+
+@check(SINGLE_COLUMN_DELIMITED, type="custom", context="body")
+class SingleColumnDelimited:
+    """A one-column table whose header and most rows contain separators: a mis-quoted CSV read as a single column."""
+
+    def __init__(self, **kwargs):
+        self.__header = None
+        self.__columns = None
+        self.__rows = 0
+        self.__delimited_rows = 0
+
+    def check_row(self, cells):
+        if self.__columns is None:
+            self.__columns = len(cells)
+            self.__header = cells[0].get("header") if cells else None
+        if len(cells) == 1:
+            self.__rows += 1
+            if _looks_delimited(cells[0].get("value")):
+                self.__delimited_rows += 1
+
+    def check_table(self):
+        if self.__columns == 1 and _looks_delimited(self.__header) and self.__rows:
+            if self.__delimited_rows / self.__rows >= 0.8:
+                return [Error(SINGLE_COLUMN_DELIMITED, row_number=1, message=SINGLE_COLUMN_DELIMITED_MSG)]
+        return []
