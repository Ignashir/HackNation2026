+from django.core.management.base import BaseCommand, CommandError
+
+from mcod.standards.aggregate import build_aggregate
+from mcod.standards.models import DataStandard
+
+
+class Command(BaseCommand):
+    help = "Build the national list of a data standard now (normally a nightly task)."
+
+    def add_arguments(self, parser):
+        parser.add_argument("code", nargs="?", default="aed")
+        parser.add_argument("--std-version", dest="std_version")
+
+    def handle(self, *args, **options):
+        standards = DataStandard.objects.filter(code=options["code"], is_active=True)
+        if options["std_version"]:
+            standards = standards.filter(version=options["std_version"])
+        standard = standards.order_by("-version").first()
+        if standard is None:
+            raise CommandError(f"No active standard {options['code']}")
+        aggregate = build_aggregate(standard)
+        stats = aggregate.stats
+        self.stdout.write(
+            f"{standard}: {stats['rows']} devices from {stats['source_rows']} provider rows in {len(stats['providers'])} files "
+            f"(merged {stats['merged_devices']}, possible duplicates {stats['possible_duplicates']}, conflicts {stats['conflicts']}, "
+            f"unresolved refs {stats['unresolved_refs']}; added {stats['added']}, changed {stats['changed']}, removed {stats['removed']}); "
+            f"dataset {aggregate.dataset_id}: list {aggregate.resource_id}, full {aggregate.full_resource_id}, "
+            f"conflicts {aggregate.conflicts_resource_id}, changes {aggregate.changes_resource_id}"
+        )
