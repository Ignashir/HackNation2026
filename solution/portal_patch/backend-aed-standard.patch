@@ -0,0 +1,156 @@
+import datetime
+import json
+from pathlib import Path
+
+from django.conf import settings
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.core.management.base import BaseCommand, CommandError
+from django.db import transaction
+from django.utils import timezone
+from django.utils.text import slugify
+
+from mcod.categories.models import Category
+from mcod.datasets.models import Dataset
+from mcod.organizations.models import Organization
+from mcod.resources.models import Resource, ResourceFile
+from mcod.standards.conformity import request_verification
+from mcod.standards.models import DataStandard
+from mcod.tags.models import Tag
+from mcod.users.models import User
+
+LICENSES = {"CC0 1.0": Dataset.LICENSE_CC0, "CC BY 4.0": Dataset.LICENSE_CC_BY}
+
+
+class Command(BaseCommand):
+    help = (
+        "Set up real AED providers on a local portal: their institutions, a representative account each, an AED-register "
+        "dataset bound to the AED standard, and their real file (uploaded as a draft that publishes once it conforms). "
+        "Idempotent."
+    )
+
+    def add_arguments(self, parser):
+        parser.add_argument("--config", default=str(Path(str(settings.DATA_DIR)) / "standards/aed/providers/providers.json"))
+        parser.add_argument("--password", default="AedTest123!", help="password for the representative accounts (local use)")
+        parser.add_argument(
+            "--institutions-only",
+            action="store_true",
+            help="only create the institutions and representative accounts; representatives publish datasets themselves",
+        )
+
+    def handle(self, *args, **options):
+        config_path = Path(options["config"])
+        config = json.loads(config_path.read_text(encoding="utf-8"))
+        std = config["standard"]
+        try:
+            standard = DataStandard.objects.get(code=std["code"], version=std["version"])
+        except DataStandard.DoesNotExist:
+            raise CommandError(f"Standard {std['code']} {std['version']} not loaded: run manage.py load_data_standards first")
+
+        category = Category.objects.filter(code="HEAL").order_by("id").first()
+        tag, _ = Tag.objects.get_or_create(name="AED", language="pl", defaults={"status": "published"})
+
+        coordinator = config["coordinator"]
+        org = self._organization(coordinator, slug=coordinator["slug"])
+        self._representative(coordinator["representative"], org, options["password"])
+        if standard.aggregate_owner_id != org.pk:
+            standard.aggregate_owner = org
+            standard.save(update_fields=["aggregate_owner"])
+        self.stdout.write(f"coordinator: {org.title} (pk={org.pk}) owns the national list of {standard}")
+
+        for provider in config["providers"]:
+            with transaction.atomic():
+                org = self._organization(provider["institution"], slug=slugify(provider["institution"]["title"]))
+                user = self._representative(provider["representative"], org, options["password"])
+                if options["institutions_only"]:
+                    self.stdout.write(f"{org.title}: institution {org.pk}, representative {user.email}")
+                    continue
+                dataset = self._dataset(provider, org, standard, category, tag)
+                resource = self._resource(provider, dataset, standard, config_path.parent)
+            state = f"file {resource.pk} ({resource.status})" if resource else "no file"
+            self.stdout.write(f"{org.title}: dataset {dataset.pk}, {state}, representative {user.email}")
+
+    def _organization(self, data, slug):
+        org = Organization.raw.filter(regon=data["regon"], is_removed=False).first() if data.get("regon") else None
+        org = org or Organization.raw.filter(title=data["title"], is_removed=False).first()
+        fields = {k: v for k, v in data.items() if k not in ("representative", "slug")}
+        if org is None:
+            # A removed institution may still hold the slug: make the new one unique.
+            base, n = slug, 2
+            while Organization.raw.filter(slug=slug).exists():
+                slug, n = f"{base}-{n}", n + 1
+            org = Organization(slug=slug, **fields)
+        else:
+            for key, value in fields.items():
+                setattr(org, key, value)
+        org.status = "published"
+        org.is_removed = False
+        org.save()
+        return org
+
+    def _representative(self, email, org, password):
+        user = User.objects.filter(email=email).first()
+        if user is None:
+            user = User.objects.create_user(email, password, fullname=f"Pełnomocnik – {org.title}")
+        user.is_staff = True
+        user.is_agent = True
+        user.fullname = user.fullname or f"Pełnomocnik – {org.title}"
+        user.phone = user.phone or getattr(org, "tel", None) or "000000000"  # staff accounts need name + phone
+        user.state = "active"
+        user.is_active = True
+        user.email_confirmed = user.email_confirmed or timezone.now()
+        user.agent_organization_main = org
+        user.save()
+        user.organizations.add(org)
+        user.agent_organizations.add(org)
+        return user
+
+    def _dataset(self, provider, org, standard, category, tag):
+        data = provider["dataset"]
+        dataset = Dataset.raw.filter(organization=org, data_standard__code=standard.code, is_removed=False).first()
+        fields = {
+            "title": data["title"],
+            "notes": data.get("notes")
+            or f"Rejestr AED instytucji {org.title} zgodny ze standardem {standard}. Źródło: {provider['source']}",
+            "organization": org,
+            "data_standard": standard,
+            "license_chosen": LICENSES.get(data.get("license")),
+            "update_frequency": data.get("update_frequency", "irregular"),
+            "has_dynamic_data": False,
+            "has_high_value_data": False,
+            "has_high_value_data_from_ec_list": False,
+            "has_research_data": False,
+            "status": "published",
+        }
+        if dataset is None:
+            dataset = Dataset.objects.create(**fields)
+        else:
+            Dataset.raw.filter(pk=dataset.pk).update(**fields)
+            dataset.refresh_from_db()
+        if category:
+            dataset.categories.set([category])
+        dataset.tags.add(tag)
+        return dataset
+
+    def _resource(self, provider, dataset, standard, base_dir):
+        if not provider.get("file"):
+            return None
+        existing = Resource.raw.filter(dataset=dataset, is_removed=False).first()
+        if existing:
+            return existing
+        path = base_dir / provider["file"]
+        resource = Resource.objects.create(
+            title=provider["dataset"]["title"],
+            description=provider.get("file_description")
+            or f"Rejestr AED – {dataset.organization.title}. Plik źródłowy z {provider['source']}.",
+            dataset=dataset,
+            status="draft",
+            data_date=datetime.date.today(),
+            has_dynamic_data=False,
+            has_high_value_data=False,
+            has_high_value_data_from_ec_list=False,
+            has_research_data=False,
+        )
+        upload = SimpleUploadedFile(name=path.name, content=path.read_bytes(), content_type="text/csv")
+        ResourceFile.objects.create(resource=resource, is_main=True, file=upload)
+        request_verification(resource)  # drafts are not processed by the portal on their own
+        return resource
diff --git a/mcod/standards/management/commands/load_data_standards.py b/mcod/standards/management/commands/load_data_standards.py
