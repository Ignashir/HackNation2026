{
  "name": "aed-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:reset": "docker compose down -v && docker compose up -d",
    "api": "node --watch server/index.js",
    "web": "vite",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:api\" \"npm:web\"",
    "build": "vite build"
  },
  "dependencies": {
    "express": "4.21.2",
    "leaflet": "1.9.4",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "vite": "5.4.11"
  }
}
