# Copy to deploy/.env and fill in. Values with "$" in them must stay in single quotes.

# Server: the public IPv4 address with dashes, plus .sslip.io.
# 203-0-113-10.sslip.io (and every subdomain of it) resolves to 203.0.113.10.
# Laptop: leave as is; laptop.sh works out the domain from the Wi-Fi address on each run.
PUBLIC_DOMAIN=203-0-113-10.sslip.io

# Login for mail.<domain> and flower.<domain>. Make the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
TOOLS_USER=team
TOOLS_PASSWORD_HASH='$2a$14$replace.me.with.the.output.of.caddy.hash-password'

# Password for the AED PostGIS database (only reachable from the machine itself).
AED_DB_PASSWORD=aed
# Host port for that database (solution/pull_all.sh expects 54329).
# AED_DB_HOST_PORT=54329

# gunicorn processes per portal component (api, admin, cms, ws). 2 suits a laptop.
# WEB_CONCURRENCY=2
# API_WORKERS=2

# Forum: set to true and start with `docker compose --profile forum up -d`.
DISCOURSE_FORUM_ENABLED=false
# Must match POSTGRES_USER / POSTGRES_PASSWORD in backend_latest/.env.
POSTGRES_USER=mcod
POSTGRES_PASSWORD=mcod
DISCOURSE_USERNAME=admin
DISCOURSE_PASSWORD=
